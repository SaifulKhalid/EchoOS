# ─────────────────────────────────────────────────────────────
# EchoOS environment variables (client-side, safe to expose)
# Copy this file to `.env.local` and fill in your Firebase values.
# Only VITE_-prefixed vars are bundled into the browser.
# Firebase web config is NOT secret — it is protected by Firestore
# Security Rules, not by hiding these values.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Base URL of the Vercel serverless proxy that holds the SECRET keys
# (Groq + TMDB). In local dev this can point to `http://localhost:3000`.
VITE_API_BASE_URL=http://localhost:3000

# LOCAL-DEV-ONLY: paste a TMDB API key (v3 auth) here to call TMDB directly
# from the browser during `npm run dev`, avoiding the need to run the Vercel
# proxy locally. Leave BLANK in production — the proxy injects the key there.
# Get a free key at https://www.themoviedb.org/settings/api
VITE_TMDB_DEV_KEY=

# ─────────────────────────────────────────────────────────────
# SECRET keys below live ONLY in Vercel project env vars, never here
# and never in the client bundle. Listed for documentation only:
#   GROQ_API_KEY=...
#   TMDB_API_KEY=...
# ─────────────────────────────────────────────────────────────
