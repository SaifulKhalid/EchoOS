rules_version = '2';

// ─────────────────────────────────────────────────────────────
// EchoOS Firestore Security Rules
// Privacy-by-design: all user data lives under users/{uid}. A request
// may only touch documents whose uid path segment equals the caller's
// authenticated uid. There is NO path by which one user can read or
// write another user's data.
//
// Active collections:
//   users/{uid}                          — user profile
//   users/{uid}/movies/{id}              — movie log
//   users/{uid}/food/{id}                — food journal
//   users/{uid}/travel/{id}              — travel log
//   users/{uid}/notes/{id}               — notes
//   users/{uid}/wishlist/{id}            — wishlist
//   users/{uid}/notifications/{id}       — in-app notifications
//   users/{uid}/reminders/{id}           — reminders
//   users/{uid}/chats/{sessionId}/messages/{id}  — chat messages
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function incoming() {
      return request.resource.data;
    }
    // Prevent unbounded document growth (Spark plan cost hygiene).
    function withinSize(maxLen) {
      return incoming().keys().size() <= maxLen;
    }
    // Rating must be a number between 0 and 10 (used by movies, food, travel).
    function ratingValid() {
      return !('rating' in incoming())
        || (incoming().rating is number
            && incoming().rating >= 0
            && incoming().rating <= 10);
    }

    // ── User profile document ─────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && incoming().uid == uid
        && withinSize(12);
      allow update: if isOwner(uid)
        && incoming().uid == uid
        && withinSize(12);
      allow delete: if isOwner(uid);

      // ── Per-user subcollections ──────────────────────────
      // Wildcard covers all data collections listed above.
      match /{collection}/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && ratingValid()
          && withinSize(40);
        allow delete: if isOwner(uid);

        // Nested subcollection: sessions/chats/messages
        match /{sub}/{subId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && withinSize(20);
          allow delete: if isOwner(uid);
        }
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
